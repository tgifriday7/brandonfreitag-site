---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Reach out to Brandon Freitag to discuss a strategic or organizational challenge, or to continue the conversation from Work That Holds.">
  <p class="kicker">A direct line</p>
  <h1>Contact</h1>

  <p>If you're a senior leader working through a strategic or organizational challenge, or you've read Work That Holds and want to continue the conversation, reach out.</p>


  <form class="contact-form" action="https://formspree.io/f/xaqvgpwo" method="POST">
    <input type="text" name="_gotcha" style="display:none" />
    <div class="field">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required />
    </div>
    <div class="field">
      <label for="message">Message (optional)</label>
      <textarea id="message" name="message" rows="6"></textarea>
    </div>
    <button type="submit">Send</button>
  </form>
</Base>

<style>
  .contact-form {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 480px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  input,
  textarea {
    font-family: 'IBM Plex Sans', system-ui, -apple-system, sans-serif;
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-body);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.65rem 0.75rem;
    width: 100%;
    appearance: none;
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-primary);
    outline-offset: 0;
  }

  textarea {
    resize: vertical;
    line-height: 1.7;
  }

  button[type="submit"] {
    font-family: 'IBM Plex Sans', system-ui, -apple-system, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    background-color: var(--color-primary);
    border: none;
    padding: 0.75rem 2rem;
    cursor: pointer;
    align-self: flex-start;
  }

  button[type="submit"]:hover {
    background-color: #16304f;
  }
</style>
