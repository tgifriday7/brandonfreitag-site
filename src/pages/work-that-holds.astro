---
import Base from '../layouts/Base.astro';

const seriesPapers = [
  {
    title: "The Five Breakpoints Leaders Miss",
    description: "Why transformations fail: five predictable breakpoints behind stalled change and stalled AI programs, and the question that detects each one early.",
    url: "https://www.workthatholds.com/p/the-five-breakpoints-leaders-miss",
  },
  {
    title: "The Stewardship Gap",
    description: "Change fades after launch because keeping it alive is nobody's job. How to sustain change in an organization by closing the stewardship gap.",
    url: "https://www.workthatholds.com/p/the-stewardship-gap",
  },
  {
    title: "Designed to Stall",
    description: "A stalled transformation is usually designed that way: the choices that make failure the path of least resistance, and how to see them before launch.",
    url: "https://www.workthatholds.com/p/designed-to-stall",
  },
  {
    title: "The AI Mirror",
    description: "Why AI projects fail after the pilot: the deployment exposes the organization around it. What it reveals, and what to fix first.",
    url: "https://www.workthatholds.com/p/the-ai-mirror",
  },
  {
    title: "Before It Breaks",
    description: "How to make change stick in an organization: seven disciplines leaders apply before the launch, not after the stall.",
    url: "https://www.workthatholds.com/p/before-it-breaks",
  },
  {
    title: "The Leader the Work Requires",
    description: "Leading transformational change: what the leader believes about the people they lead, and whether they act on it when it costs something.",
    url: "https://www.workthatholds.com/p/the-leader-the-work-requires",
  },
];

const personalPapers = [
  {
    title: "The Interview Audit",
    description: "Questions to ask before accepting a leadership role: how to screen an organization for whether your mandate can succeed, before you say yes.",
    url: "https://www.workthatholds.com/p/the-interview-audit",
  },
  // "Worth That Holds" (the root-condition essay) returns here once written.
];

const practicePapers = [
  {
    title: "Your AI Agent Won't Save You",
    description: "Why AI agents fail in production: the five breakpoints that decide an enterprise AI deployment before the technology gets the blame.",
    url: "https://www.workthatholds.com/p/your-ai-agent-wont-save-you",
  },
  {
    title: "The Win Rate Illusion",
    date: "June 16",
    description: "Your sales win rate measures the signature, not the customer's result. Two illusions revenue teams stopped questioning, and what they cost.",
    url: "https://www.workthatholds.com/p/the-win-rate-illusion",
  },
  {
    title: "The Flaw in Forward Deployment",
    date: "June 23",
    description: "The forward deployed engineer model solves the wrong problem for enterprise AI. Technical capability isn't the constraint; the organization is.",
    url: "https://www.workthatholds.com/p/the-flaw-in-forward-deployment",
  },
  {
    title: "The Altitude Problem",
    date: "June 30",
    description: "AI governance challenges start upstream of governance. Why the conversation happens at the wrong altitude, and where the problem sits.",
    url: "https://www.workthatholds.com/p/the-band-aid-problem",
  },
  {
    title: "When Good Enough Isn't",
    date: "July 7",
    description: "Watermelon metrics: the dashboard is green and the results aren't. What your success rate is hiding, and why the system is built not to notice.",
    url: "https://www.workthatholds.com/p/when-good-enough-isnt",
  },
];
---

<Base title="Work That Holds" description="A six-paper series on the structural reasons large-scale initiatives break down and the disciplines required to address them before they do.">
  <h1>Work That Holds</h1>

  <p>Seventy percent of large initiatives fail. Most of the remaining thirty percent deliver something less than what was promised. The conditions for both outcomes were set before the work began.</p>

  <p><a href="https://workthatholds.com" target="_blank" rel="noopener noreferrer">Work That Holds</a> is a publication for senior leaders who want an honest read on why that happens and what it takes to build something that holds.</p>

  <h2>The Why Change Fails series</h2>

  <ol class="paper-list">
    {seriesPapers.map((paper) => (
      <li class="paper-item">
        <a href={paper.url} target="_blank" rel="noopener noreferrer" class="paper-title">{paper.title}</a>
        <p class="paper-description">{paper.description}</p>
      </li>
    ))}
  </ol>

  <div class="research-callout">
    <p class="research-callout__label">The research behind the framework</p>
    <p class="research-callout__body">Sources across consulting firms, academic institutions, and business media, organized by breakpoint and searchable by publisher.</p>
    <a href="https://research.workthatholds.com" target="_blank" rel="noopener noreferrer" class="research-callout__link">Explore the evidence &rarr;</a>
  </div>

  <h2>The Work in Practice</h2>

  <ol class="paper-list">
    {practicePapers.map((paper) => (
      <li class="paper-item">
        {paper.url ? (
          <a href={paper.url} target="_blank" rel="noopener noreferrer" class="paper-title">{paper.title}</a>
        ) : (
          <span class="paper-title paper-title--upcoming">{paper.title} <span class="paper-date">{paper.date}</span></span>
        )}
        <p class="paper-description">{paper.description}</p>
      </li>
    ))}
  </ol>

  <h2>The Work at a Personal Level</h2>

  <ol class="paper-list">
    {personalPapers.map((paper) => (
      <li class="paper-item">
        {paper.url ? (
          <a href={paper.url} target="_blank" rel="noopener noreferrer" class="paper-title">{paper.title}</a>
        ) : (
          <span class="paper-title paper-title--upcoming">{paper.title}</span>
        )}
        <p class="paper-description">{paper.description}</p>
      </li>
    ))}
  </ol>

  <p class="archive-link">
    <a href="https://workthatholds.com" target="_blank" rel="noopener noreferrer">Read the full Work That Holds archive on Substack</a>
  </p>
</Base>

<style>
  h2 {
    margin-top: 2.5rem;
  }

  .paper-list {
    list-style: none;
    margin: 0 0 2.5rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .paper-item {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }

  .paper-title {
    display: block;
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-bottom: 0.5rem;
  }

  .paper-title--upcoming {
    color: var(--color-secondary);
    text-decoration: none;
    cursor: default;
  }

  .paper-date {
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--color-secondary);
  }

  .paper-description {
    font-size: 0.95rem;
    color: var(--color-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .research-callout {
    border: 1px solid #D0D9E8;
    border-left: 4px solid var(--color-primary);
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
    margin: 2.5rem 0;
    background: #F5F8FC;
  }

  .research-callout__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.4rem 0;
  }

  .research-callout__body {
    font-size: 0.95rem;
    color: var(--color-secondary);
    line-height: 1.6;
    margin: 0 0 0.85rem 0;
  }

  .research-callout__link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .research-callout__link:hover {
    color: #1a5276;
  }

  .archive-link {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
    margin-top: 0;
  }

  .archive-link a {
    font-size: 0.95rem;
  }
</style>
